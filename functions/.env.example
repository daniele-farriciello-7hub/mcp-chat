# Copy to .env (gitignored) for the emulator, and set the same value as a deployed function
# secret/env var in production. Losing or rotating this key makes every stored database password
# unreadable — see functions/src/db/credentials.js.
#
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DB_CRED_KEY=
